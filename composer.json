{
  "name": "nafrucom/email",
  "description": "Official Nafru Email PHP SDK: send transactional and marketing email from PHP with a Resend-compatible email API, plus contacts, broadcasts, templates, custom events, webhook verification and Connect with Nafru (OAuth).",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "email",
    "email-api",
    "transactional-email",
    "marketing-email",
    "smtp-alternative",
    "resend",
    "webhooks",
    "nafru",
    "sdk",
    "php"
  ],
  "homepage": "https://github.com/nafrucom/nafru-email",
  "support": {
    "source": "https://github.com/nafrucom/nafru-email-sdks",
    "issues": "https://github.com/nafrucom/nafru-email-sdks/issues"
  },
  "authors": [
    {
      "name": "Nafru"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "Nafru\\Email\\": "php/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Nafru\\Email\\Tests\\": "php/tests/"
    }
  },
  "scripts": {
    "test": "phpunit -c php/phpunit.xml.dist"
  },
  "config": {
    "sort-packages": true
  }
}
